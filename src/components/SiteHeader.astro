---
import ThemeToggle from "./ThemeToggle.astro";

const descriptor = "从零基础到独立演奏、即兴、扒歌、编曲与创作";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="吉他教程首页">
      <svg class="site-brand__mark" aria-hidden="true" viewBox="0 0 44 44">
        <path d="M7 8v28M13 8v28M19 8v28M25 8v28M31 8v28M37 8v28"></path>
        <path d="M5 15c8-5 15 7 24 1 5-3 8-1 10 1M5 27c8 5 15-7 24-1 5 3 8 1 10-1"></path>
      </svg>
      <span>
        <strong>吉他教程</strong>
        <small>{descriptor}</small>
      </span>
    </a>
    <nav class="site-header__nav" aria-label="主导航">
      <a href="/#course-map">课程路线</a>
      <a href="/#practice-method">练习方法</a>
      <a href="/#about">关于</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
