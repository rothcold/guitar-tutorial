---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { SITE_INDEXING_ENABLED } from "astro:env/server";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  canonicalPath,
  type = "website",
} = Astro.props;
const siteName = "吉他教程";
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("guitar-tutorial:theme");
        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={SITE_INDEXING_ENABLED ? "index, follow" : "noindex, nofollow"}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <title>{pageTitle}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      const completedKey = "guitar-tutorial:completed";

      function completedLessonIds() {
        try {
          const value = JSON.parse(localStorage.getItem(completedKey) ?? "[]");
          return Array.isArray(value) ? value : [];
        } catch {
          return [];
        }
      }

      function renderLocalProgress() {
        const completed = new Set(completedLessonIds());
        document.querySelectorAll<HTMLElement>("[data-lesson-node]").forEach((node) => {
          node.classList.toggle("is-complete", completed.has(node.dataset.lessonId));
        });

        document.querySelectorAll<HTMLElement>("[data-course-progress]").forEach((rail) => {
          rail.style.setProperty("--course-progress", `${(completed.size / 15) * 100}%`);
        });
      }

      window.addEventListener("lesson-progress-change", renderLocalProgress);
      renderLocalProgress();
    </script>
  </body>
</html>
