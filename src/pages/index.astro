---
import SiteLayout from "../layouts/SiteLayout.astro";
import CourseRouteNode from "../components/CourseRouteNode.astro";
import { getLessonPath, getOrderedLessons } from "../lib/lessons";

const lessons = await getOrderedLessons();
const firstLesson = lessons[0];
const descriptor = "从零基础到独立演奏、即兴、扒歌、编曲与创作";

const sharedFoundation = lessons.filter((lesson) => lesson.data.order <= 7);
const branchLessons = lessons.filter((lesson) => lesson.data.track !== "common");
const sharedAdvanced = lessons.filter((lesson) => lesson.data.order >= 10);
---

<SiteLayout
  title="吉他教程"
  description={descriptor}
  canonicalPath="/"
>
  <main id="main-content" class="home-main">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow"><span></span> 从零基础到完整音乐能力</p>
        <h1 id="home-title">从第一把琴，<br />到自己的声音。</h1>
        <p class="home-hero__descriptor">{descriptor}</p>
        <p class="home-hero__intro">
          按一条清晰的信号路径学习：先建立动作与节奏，再走向指板、即兴、扒歌、编曲与创作。每一篇都有可以直接执行的练习安排。
        </p>
        <div class="home-hero__actions">
          {
            firstLesson && (
              <a class="primary-link" href={getLessonPath(firstLesson)}>从第一篇开始 <span aria-hidden="true">↗</span></a>
            )
          }
          <a class="secondary-link" href="#course-map">查看课程路线</a>
        </div>
        <dl class="home-hero__stats">
          <div><dt>15</dt><dd>篇教程</dd></div>
          <div><dt>6</dt><dd>个阶段</dd></div>
          <div><dt>2</dt><dd>条分流路线</dd></div>
        </dl>
      </div>

      <div class="home-hero__visual">
        <svg class="signal-visual" aria-hidden="true" viewBox="0 0 500 420">
          <g class="signal-visual__fretboard" transform="translate(-38 18) rotate(-17 245 210)">
            <path class="signal-visual__field" d="M90 30h330v390H90z"></path>
            <g class="signal-visual__strings">
              <path d="M112 30v390"></path><path d="M168 30v390"></path>
              <path d="M224 30v390"></path><path d="M280 30v390"></path>
              <path d="M336 30v390"></path><path d="M392 30v390"></path>
            </g>
            <g class="signal-visual__frets">
              <path d="M90 96h330M90 164h330M90 236h330M90 312h330M90 392h330"></path>
            </g>
            <g class="signal-visual__nodes">
              <circle cx="252" cy="132" r="13"></circle>
              <circle cx="308" cy="274" r="13"></circle>
            </g>
          </g>
          <g class="signal-visual__dots">
            {Array.from({ length: 24 }, (_, index) => (
              <circle cx={392 + (index % 4) * 18} cy={42 + Math.floor(index / 4) * 18} r="2"></circle>
            ))}
          </g>
          <path class="signal-visual__wave" d="M0 260c24 0 25-26 46-26s20 42 42 42 22-31 44-31 25 19 48 19 21-57 43-57 21 105 44 105 23-75 44-75 24 40 47 40 21-25 44-25 21 13 42 13 28-8 56-8"></path>
          <circle class="signal-visual__annotation" cx="268" cy="312" r="32"></circle>
        </svg>

        {
          firstLesson && (
            <a class="continue-card" href={getLessonPath(firstLesson)} data-continue-card>
              <span class="continue-card__label">从这里开始</span>
              <strong data-continue-title>{firstLesson.data.title}</strong>
              <small data-continue-description>{firstLesson.data.description}</small>
              <span class="continue-card__action" data-continue-action>开始学习 <span aria-hidden="true">↗</span></span>
            </a>
          )
        }
      </div>
    </section>

    <section class="home-section home-course" id="course-map" aria-labelledby="course-heading">
      <div class="home-section__heading">
        <p class="eyebrow"><span></span> SIGNAL PATH · 学习路线</p>
        <h2 id="course-heading">一条线，直到你不再需要它。</h2>
        <p>
          前七篇建立共同基础，第八篇按乐器分流，第九篇重新汇合。完成状态只保存在这台设备上，也不会锁住任何内容。
        </p>
        <div class="route-legend" aria-label="路线图例">
          <span><i></i>共同路线</span>
          <span><i></i>分流路线</span>
          <span><i></i>本机已完成</span>
        </div>
      </div>

      <div class="course-signal-track">
        {sharedFoundation.map((lesson) => <CourseRouteNode lesson={lesson} />)}
        <p class="course-signal-track__label">07 后选择主修路线，两条都保持开放</p>
        <div class="course-signal-track__branches">
          {branchLessons.map((lesson) => <CourseRouteNode lesson={lesson} />)}
        </div>
        <p class="course-signal-track__label course-signal-track__label--merge">在 09 重新汇合</p>
        {sharedAdvanced.map((lesson) => <CourseRouteNode lesson={lesson} />)}
      </div>
    </section>

    <section class="home-section home-guide" id="practice-method" aria-labelledby="guide-heading">
      <div class="home-section__heading">
        <p class="eyebrow"><span></span> PRACTICE LOOP · 练习方法</p>
        <h2 id="guide-heading">练习不是完成页面，是听见变化。</h2>
        <p>每一轮都从明确任务开始，以可听见、可复查的结果结束。</p>
      </div>
      <ol class="practice-steps">
        <li><span>01</span><strong>选择时间档</strong><p>从 25、45 或 90 分钟中选择当天能稳定完成的一档。</p></li>
        <li><span>02</span><strong>运行训练日</strong><p>按当前训练日完成核心项与轮换项，休息后顺延，不追赶。</p></li>
        <li><span>03</span><strong>留下证据</strong><p>保存一次短录音、谱例、分析表或工程版本，再决定下一轮重点。</p></li>
      </ol>
    </section>
  </main>

  <script>
    const lastLessonKey = "guitar-tutorial:last-lesson";
    const preferredTrackKey = "guitar-tutorial:preferred-track";

    try {
      const lastLesson = JSON.parse(localStorage.getItem(lastLessonKey) ?? "null");
      const continueCard = document.querySelector<HTMLAnchorElement>("[data-continue-card]");

      if (continueCard && lastLesson?.path && lastLesson?.title) {
        continueCard.href = `${lastLesson.path}?resume=1`;
        const title = continueCard.querySelector<HTMLElement>("[data-continue-title]");
        const description = continueCard.querySelector<HTMLElement>("[data-continue-description]");
        const action = continueCard.querySelector<HTMLElement>("[data-continue-action]");
        if (title) title.textContent = lastLesson.title;
        if (description) description.textContent = lastLesson.description ?? "回到上次阅读的位置";
        if (action) action.firstChild!.textContent = "继续学习 ";
        continueCard.querySelector(".continue-card__label")!.textContent = "继续上次学习";

        document.querySelector<HTMLElement>(`[data-lesson-path="${lastLesson.path}"]`)?.classList.add("is-current");
      }
    } catch {
      localStorage.removeItem(lastLessonKey);
    }

    const preferredTrack = localStorage.getItem(preferredTrackKey);
    if (preferredTrack === "acoustic" || preferredTrack === "electric") {
      document.querySelector<HTMLElement>(`[data-track="${preferredTrack}"]`)?.classList.add("is-preferred");
    }

    document.querySelectorAll<HTMLAnchorElement>("[data-track='acoustic'], [data-track='electric']").forEach((link) => {
      link.addEventListener("click", () => {
        localStorage.setItem(preferredTrackKey, link.dataset.track!);
      });
    });
  </script>
</SiteLayout>
